---
const modelNames: Record<string, string> = {
  "1B": "LLaMA 3.2-1B",
  "3B": "LLaMA 3.2-3B",
};
const inflation = [
  ["1B", "FreshQA", "87.26 → 1,190.76", "13.65×", "26.89 → 10.24", "0.38×"],
  [
    "1B",
    "MuSR · Object placement",
    "146.30 → 856.08",
    "5.85×",
    "35.56 → 18.48",
    "0.52×",
  ],
  [
    "1B",
    "MuSR · Murder mystery",
    "316.02 → 2,618.30",
    "8.29×",
    "24.74 → 9.04",
    "0.37×",
  ],
  ["3B", "FreshQA", "62.43 → 500.56", "8.02×", "59.68 → 38.79", "0.65×"],
  [
    "3B",
    "MuSR · Object placement",
    "97.80 → 140.26",
    "1.43×",
    "47.84 → 33.10",
    "0.69×",
  ],
  [
    "3B",
    "MuSR · Murder mystery",
    "336.70 → 510.38",
    "1.52×",
    "64.08 → 38.20",
    "0.60×",
  ],
];
const inflationGroups = Object.entries(modelNames).map(([scale, model]) => ({
  model,
  rows: inflation.filter((row) => row[0] === scale),
}));
const hcot = [
  ["1B", "26.0%", "8.8%", "0.0%"],
  ["3B", "24.0%", "6.4%", "0.0%"],
];
const adaptive = [
  ["1B", "CODI", "70.33", "61.00", "79.00"],
  ["1B", "SaLR", "3.67", "0.00", "6.00"],
  ["3B", "CODI", "82.67", "43.00", "57.00"],
  ["3B", "SaLR", "5.33", "1.00", "8.00"],
];
const adaptiveGroups = Object.entries(modelNames).map(([scale, model]) => ({
  model,
  rows: adaptive.filter((row) => row[0] === scale),
}));
---

<div class="attack-callouts not-prose">
  <article>
    <h3 class="eyebrow">OverThink · Token inflation</h3>
    <p>
      On 1B FreshQA, OverThink increases SFT-CoT's generated token count by
      <strong>13.65×</strong>, while SaLR's token ratio is <strong>0.38×</strong>.
      SaLR shows no token inflation across the six evaluated model task settings.
    </p>
  </article>
  <article>
    <h3 class="eyebrow">H-CoT · Reasoning hijacking</h3>
    <p>
      On Malicious-Educator, SaLR records <strong
        >0 successful attacks out of 250 attempts</strong
      > per model at both 1B and 3B.
    </p>
  </article>
</div>
<details class="evidence-details breakout not-prose">
  <summary>OverThink and H-CoT results <span>Tables 4–5</span></summary>
  <div class="details-body">
    <h3>OverThink: generated tokens before → after attack</h3>
    <div
      class="table-scroll"
      tabindex="0"
      role="region"
      aria-label="OverThink results; scroll horizontally for all columns"
    >
      <table class="overthink-table">
        <thead
          ><tr
            ><th scope="col" class="overthink-model-cell">Model</th><th
              scope="col">Task</th
            ><th scope="col"
              >SFT-CoT tokens</th
            ><th scope="col">Token ratio</th><th scope="col">SaLR tokens</th><th
              scope="col">Token ratio</th
            ></tr
          ></thead
        >
        {
          inflationGroups.map((group) => (
            <tbody>
              {group.rows.map((row, rowIndex) => (
                <tr>
                  {rowIndex === 0 && (
                    <th
                      scope="rowgroup"
                      rowspan={group.rows.length}
                      class="overthink-model-cell"
                    >
                      {group.model}
                    </th>
                  )}
                  {row.slice(1).map((cell, index) => (
                    <td class:list={{ "salr-value": index >= 3 }}>{cell}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          ))
        }
      </table>
    </div>
    <p class="table-note">
      Token ratio = attacked / clean average generated tokens.
    </p>
    <h3>H-CoT: attack success per attempt (%) ↓</h3>
    <div
      class="table-scroll"
      tabindex="0"
      role="region"
      aria-label="H-CoT results; scroll horizontally for all columns"
    >
      <table>
        <thead
          ><tr
            ><th scope="col">Model</th><th scope="col">SFT-CoT</th><th
              scope="col">SFT-CoT + SafeChain</th
            ><th scope="col">SaLR</th></tr
          ></thead
        ><tbody
          >{
            hcot.map((row) => (
              <tr>
                {row.map((cell, index) =>
                  index === 0 ? (
                    <th scope="row">{modelNames[cell] ?? cell}</th>
                  ) : (
                    <td class:list={{ "salr-value": index === 3 }}>{cell}</td>
                  ),
                )}
              </tr>
            ))
          }</tbody
        >
      </table>
    </div>
    <p class="table-note">
      50 Malicious-Educator queries × 5 attempts per query, per model. Success
      is judged by GPT-5.1 with harmfulness rating ≥ 3.
    </p>
  </div>
</details>
<details class="evidence-details breakout not-prose">
  <summary
    >Multi-turn jailbreaks and attacks on latent states <span>Table 7</span
    ></summary
  >
  <div class="details-body">
    <p>
      Crescendo tests multi-turn jailbreaks, while the latent rollout attacks use
      white-box access to perturb intermediate reasoning states.
    </p>
    <div
      class="table-scroll"
      tabindex="0"
      role="region"
      aria-label="Multi-turn and latent attack results; scroll horizontally for all columns"
    >
      <table>
        <thead
          ><tr
            ><th scope="col">Model</th><th scope="col">Method</th><th
              scope="col">Crescendo</th
            ><th scope="col">Projected latent</th><th scope="col"
              >Unconstrained latent</th
            ></tr
          ></thead
        >
        {
          adaptiveGroups.map((group) => (
            <tbody>
              {group.rows.map((row, rowIndex) => (
                <tr>
                  {rowIndex === 0 && (
                    <th scope="rowgroup" rowspan={group.rows.length}>
                      {group.model}
                    </th>
                  )}
                  {row.slice(1).map((cell) => (
                    <td class:list={{ "salr-value": row[1] === "SaLR" }}>
                      {cell}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          ))
        }
      </table>
    </div>
    <p class="table-note">
      Selected results from Table 7. ASR (%), lower is better. The projected latent
      attack constrains perturbation norms, while the unconstrained variant
      removes this constraint.
    </p>
  </div>
</details>
