---
import { Icon } from "astro-icon/components";
interface Props {
  title: string;
  authors: { name: string; url?: string; notes?: string }[];
  affiliation: string;
  links: { name: string; url: string; icon: string }[];
}
const { title, authors, affiliation, links } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header class="publication-header full-bleed">
  <div class="header-inner">
    <h1><code>SaLR</code></h1>
    <p class="publication-title">{title}</p>
    <p class="conference-label">NeurIPS 2026 · Main Track</p>
    <div class="authors">
      {
        // prettier-ignore
        authors.map((author) => (
          <span>{author.url ? <a href={author.url} target="_blank" rel="noopener noreferrer">{author.name}</a> : author.name}{author.notes && <sup>{author.notes}</sup>}</span>
        ))
      }
    </div>
    <div class="affiliation-row">
      <p class="affiliation">{affiliation}</p>
      <img
        class="affiliation-logo"
        src={`${base}/aspire-transparent.png`}
        alt="ASPIRE — AI Security, Privacy and Robustness"
        width="1895"
        height="830"
      />
    </div>
    <p class="author-notes">
      <span><sup>*</sup>Equal contribution.</span>
      <span><sup>†</sup>Corresponding author.</span>
    </p>
    <div class="publication-links not-prose">
      {
        links.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer">
            <>
              <Icon name={link.icon} />
              <span>{link.name}</span>
            </>
          </a>
        ))
      }
    </div>
  </div>
</header>
