---
interface Props {
  name: "intro" | "method";
  alt: string;
}
const { name, alt } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const src = `${base}/figures/salr-${name}.svg`;
const figures = {
  intro: {
    width: 770,
    height: 402,
    title: "Explore the overview",
    fullTitle: "Safety diagnosis and SaLR overview",
    fullDescription:
      "Panels (a) and (b) show jailbreak vulnerability and hidden state separation. Panels (c) and (d) illustrate compact safe-chains and the safety utility comparison.",
    steps: [
      {
        label: "Jailbreak risk",
        title: "(a) Jailbreak vulnerability",
        description:
          "On 1B AdvBench under GCG, ASR is 38.8% for Base, 61.0% for SFT-CoT, and 90.9% for CODI, compared with 2.7% for SaLR.",
        box: [0, 0, 404, 214],
      },
      {
        label: "Internal states",
        title: "(b) Weaker separation of safe and unsafe queries",
        description:
          "Before response generation, the visualized hidden states show increasing overlap between safe and unsafe queries from Base to SFT-CoT to CODI.",
        box: [410, 0, 360, 214],
      },
      {
        label: "Compact safe-chain",
        title: "(c) Compact safety supervision",
        description:
          "Each safe-chain contains four blocks: a request summary, risk assessment, response action (refuse, partial, or allow), and safe follow-up.",
        box: [0, 220, 404, 182],
      },
      {
        label: "Safety and utility",
        title: "(d) Safety utility comparison",
        description:
          "On the 1B model, SaLR achieves 2.0% mean ASR on AdvBench under GCG and PAIR and 55.74% OOD math accuracy, compared with 88.2% ASR and 55.84% accuracy for CODI.",
        box: [410, 220, 360, 182],
      },
    ],
  },
  method: {
    width: 832,
    height: 337,
    title: "Walk through SaLR",
    fullTitle: "Compact traces and response prefix distillation",
    fullDescription:
      "Safety examples align hidden states across four response prefix positions (K = 4), while mathematical examples use single position alignment at the answer onset.",
    steps: [
      {
        label: "Training signals",
        title: "Compact safety traces and mathematical reasoning",
        description:
          "Safety examples pair a request with a compact safe-chain and a safe response. Mathematical examples pair a question with a structured reasoning trace and its answer.",
        box: [0, 0, 192, 337],
      },
      {
        label: "Teacher → student",
        title: "Distilling explicit reasoning into a latent student",
        description:
          "The teacher learns from the explicit trace and target response. The student uses latent space reasoning and does not read that trace. Hidden state distillation transfers the teacher’s supervision at the transition from latent space reasoning into response generation.",
        box: [198, 33, 634, 134],
      },
      {
        label: "Safety alignment",
        title: "Aligning the start of a safe response",
        description:
          "For safety examples, SaLR aligns teacher and student hidden states over the first four response positions (K = 4). This prefix supervision guides the student toward a safe response trajectory as it begins to generate its reply.",
        box: [233, 186, 297, 98],
      },
      {
        label: "Reasoning utility",
        title: "Single position alignment for mathematical reasoning",
        description:
          "Mathematical examples align teacher and student hidden states at a single position at the answer onset.",
        box: [546, 186, 252, 98],
      },
      {
        label: "At inference",
        title: "Answer generation after a fixed latent rollout",
        description:
          "At inference, the student takes six latent reasoning steps and then generates its response without emitting a long textual chain of thought. The teacher and explicit reasoning traces are needed only during training.",
        box: [217, 36, 288, 122],
      },
    ],
  },
};
const { width, height, title, fullTitle, fullDescription, steps } =
  figures[name];
---

<figure class="paper-figure breakout" aria-labelledby={`figure-title-${name}`}>
  <salr-figure
    class="figure-player not-prose"
    data-name={name}
    data-full-box={`0 0 ${width} ${height}`}
    style={`--figure-ratio: ${width} / ${height}`}
  >
    <div class="figure-toolbar" hidden>
      <span>{title}</span>
      <button type="button" class="figure-play" aria-pressed="false"
        >Play explanation</button
      >
    </div>
    <div class="figure-stage">
      <img
        class="figure-fallback"
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
      />
      <svg
        class="figure-viewport"
        viewBox={`0 0 ${width} ${height}`}
        role="img"
        aria-label={alt}
        data-alt={alt}
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <clipPath id={`figure-clip-${name}`}>
            <rect class="figure-clip" x="0" y="0" width={width} height={height}
            ></rect>
          </clipPath>
        </defs>
        <g clip-path={`url(#figure-clip-${name})`}>
          <image href={src} width={width} height={height} />
          <rect
            class="figure-focus"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            vector-effect="non-scaling-stroke"
            rx="4"
            visibility="hidden"></rect>
        </g>
      </svg>
    </div>
    <div class="figure-narrative" aria-live="polite" aria-atomic="true">
      <h3 id={`figure-title-${name}`}>{fullTitle}</h3>
      <p>{fullDescription}</p>
    </div>
    <div
      class="figure-steps"
      role="group"
      aria-label={`Choose a ${name === "intro" ? "overview" : "method"} explanation step`}
      hidden
    >
      <button
        type="button"
        data-step="-1"
        data-title={fullTitle}
        data-description={fullDescription}
        aria-pressed="true">Full figure</button
      >
      {
        steps.map((step, index) => (
          <button
            type="button"
            data-step={index}
            data-box={step.box.join(" ")}
            data-title={step.title}
            data-description={step.description}
            aria-pressed="false"
          >
            <span class="figure-step-number" aria-hidden="true">
              {index + 1}
            </span>
            {step.label}
          </button>
        ))
      }
    </div>
  </salr-figure>
</figure>

<script>
  class SaLRFigure extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      if (this.cleanup) return;
      const svg = this.querySelector<SVGSVGElement>(".figure-viewport")!;
      const focus = this.querySelector<SVGRectElement>(".figure-focus")!;
      const clip = this.querySelector<SVGRectElement>(".figure-clip")!;
      const play = this.querySelector<HTMLButtonElement>(".figure-play")!;
      const controls = this.querySelector<HTMLElement>(".figure-steps")!;
      const buttons = Array.from(
        controls.querySelectorAll<HTMLButtonElement>("button"),
      );
      const steps = buttons.filter((button) => button.dataset.step !== "-1");
      const narrative = this.querySelector<HTMLElement>(".figure-narrative")!;
      const heading = narrative.querySelector("h3")!;
      const paragraph = narrative.querySelector("p")!;
      const fullBox = this.dataset.fullBox!.split(" ").map(Number);
      const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const controller = new AbortController();
      const { signal } = controller;
      let currentBox = [...fullBox];
      let index = -1;
      let playing = false;
      let timer: number | undefined;
      let frame = 0;

      const playbackLabel = () => {
        this.classList.toggle("is-playing", playing);
        play.setAttribute("aria-pressed", String(playing));
        play.textContent = playing
          ? "Pause explanation"
          : index === steps.length - 1
            ? "Replay explanation"
            : "Play explanation";
        narrative.setAttribute("aria-live", playing ? "off" : "polite");
      };
      const pause = () => {
        window.clearTimeout(timer);
        playing = false;
        playbackLabel();
      };
      const zoomTo = (destination: number[]) => {
        cancelAnimationFrame(frame);
        const start = [...currentBox];
        const started = performance.now();
        const tick = (now: number) => {
          const progress = motion.matches
            ? 1
            : Math.min((now - started) / 800, 1);
          const eased =
            progress < 0.5
              ? 4 * progress ** 3
              : 1 - (-2 * progress + 2) ** 3 / 2;
          currentBox = start.map(
            (value, i) => value + (destination[i] - value) * eased,
          );
          svg.setAttribute("viewBox", currentBox.join(" "));
          ["x", "y", "width", "height"].forEach((key, i) =>
            clip.setAttribute(key, String(currentBox[i])),
          );
          if (progress < 1) frame = requestAnimationFrame(tick);
        };
        if (motion.matches) tick(started);
        else frame = requestAnimationFrame(tick);
      };
      const showStep = (next: number) => {
        index = next;
        buttons.forEach((button) =>
          button.setAttribute(
            "aria-pressed",
            String(Number(button.dataset.step) === index),
          ),
        );
        const step = steps[index];
        const selected = step ?? buttons[0];
        heading.textContent = selected.dataset.title!;
        paragraph.textContent = selected.dataset.description!;
        focus.setAttribute("visibility", step ? "visible" : "hidden");
        if (step) {
          const box = step.dataset.box!.split(" ").map(Number);
          svg.setAttribute(
            "aria-label",
            `${svg.dataset.alt} ${step.dataset.title}`,
          );
          ["x", "y", "width", "height"].forEach((key, i) =>
            focus.setAttribute(key, String(box[i] + (i < 2 ? 2 : -4))),
          );
          zoomTo(box);
        } else {
          svg.setAttribute("aria-label", svg.dataset.alt!);
          zoomTo(fullBox);
        }
        playbackLabel();
      };
      const schedule = () => {
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          if (index < steps.length - 1) {
            showStep(index + 1);
            schedule();
          } else pause();
        }, 7000);
      };

      buttons.forEach((button) =>
        button.addEventListener(
          "click",
          () => {
            pause();
            showStep(Number(button.dataset.step));
          },
          { signal },
        ),
      );
      play.addEventListener(
        "click",
        () => {
          if (playing) return pause();
          document.dispatchEvent(
            new CustomEvent("salr:figure-play", { detail: this }),
          );
          if (index < 0 || index === steps.length - 1) showStep(0);
          playing = true;
          playbackLabel();
          schedule();
        },
        { signal },
      );
      controls.addEventListener(
        "keydown",
        (event) => {
          const selected = buttons.indexOf(event.target as HTMLButtonElement);
          if (selected < 0) return;
          const keys: Record<string, number> = {
            ArrowRight: (selected + 1) % buttons.length,
            ArrowLeft: (selected - 1 + buttons.length) % buttons.length,
            Home: 0,
            End: buttons.length - 1,
          };
          if (!(event.key in keys)) return;
          event.preventDefault();
          const button = buttons[keys[event.key]];
          button.focus();
          button.click();
        },
        { signal },
      );
      document.addEventListener(
        "salr:figure-play",
        (event) => {
          if ((event as CustomEvent).detail !== this) pause();
        },
        { signal },
      );
      document.addEventListener(
        "visibilitychange",
        () => {
          if (document.hidden) pause();
        },
        { signal },
      );
      const observer = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting && playing) pause();
      });
      observer.observe(this);

      this.setAttribute("data-enhanced", "");
      this.querySelector<HTMLElement>(".figure-toolbar")!.hidden = false;
      controls.hidden = false;
      this.cleanup = () => {
        controller.abort();
        observer.disconnect();
        window.clearTimeout(timer);
        cancelAnimationFrame(frame);
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
      this.cleanup = undefined;
    }
  }
  if (!customElements.get("salr-figure"))
    customElements.define("salr-figure", SaLRFigure);
</script>
